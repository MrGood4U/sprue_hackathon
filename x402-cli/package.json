{
  "name": "@sprue/hedera-x402-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Hedera x402 command-line client",
  "type": "module",
  "bin": {
    "hx402": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/core": "2.25.0",
    "@x402/fetch": "2.25.0",
    "@x402/hedera": "2.25.0"
  },
  "overrides": {
    "@hiero-ledger/sdk": "2.88.0",
    "protobufjs": "8.8.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
