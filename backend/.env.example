# Copy to .env and supply a local-only password matching compose.db.yml.
DATABASE_URL=postgresql://sprue:replace-with-local-password@127.0.0.1:54329/sprue
# Set false to fetch and verify Graph schema evidence on every planning request.
GRAPH_SCHEMA_CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:16379
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=54329
CONTAINER_DATABASE_URL=postgresql://sprue:replace-with-local-password@postgres:5432/sprue
# For remote TLS, use sslmode=verify-full and the appropriate trusted CA.
# No production URL, credential, wallet, provider token or signer key belongs here.

NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=local
HOST=127.0.0.1
PORT=3001
WORKER_PORT=3002
API_BASE_URL=http://127.0.0.1:3001
CONSOLE_PUBLIC_URL=http://127.0.0.1:4173
DATA_PUBLIC_BASE_URL=http://127.0.0.1:3001/data/v1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173
# Public identifier returned to the Creator Console.
PRIVY_APP_ID=
# Server-only secret. Set both Privy values to enable creator authentication.
PRIVY_APP_SECRET=

# Required for durable Model Service and Graph API-key storage. Values are
# 32-byte base64url keys; retain old entries until every referenced row is re-encrypted.
# Generate a local key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Example shape: {"local-v1":"<43-character-base64url-key>"}
MODEL_CREDENTIAL_KEYRING=
MODEL_CREDENTIAL_ACTIVE_KEY_ID=

# Source discovery and Graph data access are pinned to The Graph mainnet environment.
GRAPH_GATEWAY_ENVIRONMENT=mainnet

# Hedera downstream settlement is deliberately pinned to testnet for the MVP.
HEDERA_NETWORK=hedera:testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# Server-only Hedera Portal personal access token. The API uses it only after
# an authenticated creator explicitly requests testnet account activation.
HEDERA_PORTAL_PAT=
HEDERA_FAUCET_URL=https://portal.hedera.com/api/disbursement/cli
HEDERA_FAUCET_AMOUNT_HBAR=1
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Enables the explicit server-backed evaluator demo runtime. Keep false for a production API.
DEMO_RUNTIME_ENABLED=true

# Agent configuration is server-side only. Mock mode is the safe default and makes no model request.
AGENT_MODE=mock
AGENT_API_URL=
AGENT_API_KEY=
AGENT_MODEL=sprue-mock-planner
AGENT_TIMEOUT_MS=600000
AGENT_RUN_TIMEOUT_MS=3600000
# Enables additional server-side planning metadata diagnostics. Keep false outside local debugging.
AGENT_DEBUG=false
