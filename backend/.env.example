# Copy to .env and supply a local-only password matching compose.db.yml.
DATABASE_URL=postgresql://sprue:replace-with-local-password@127.0.0.1:54329/sprue
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=54329
CONTAINER_DATABASE_URL=postgresql://sprue:replace-with-local-password@postgres:5432/sprue
# For remote TLS, use sslmode=verify-full and the appropriate trusted CA.
# No production URL, credential, wallet, provider token or signer key belongs here.

NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=local
HOST=127.0.0.1
PORT=3001
WORKER_PORT=3002
API_BASE_URL=http://127.0.0.1:3001
CONSOLE_PUBLIC_URL=http://127.0.0.1:4173
DATA_PUBLIC_BASE_URL=http://127.0.0.1:3001/data/v1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173
# Public identifier only. Setting it does not install or enable a verifier.
PRIVY_APP_ID=

# Agent configuration is server-side only. Mock mode is the safe default and makes no model request.
AGENT_MODE=mock
AGENT_API_URL=
AGENT_API_KEY=
AGENT_MODEL=sprue-mock-planner
AGENT_TIMEOUT_MS=30000
