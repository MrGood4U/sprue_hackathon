{
  "name": "sprue-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:status": "node --import tsx scripts/migrate.ts --status",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:check": "node --import tsx scripts/check-schema.ts",
    "db:up": "docker compose -f compose.db.yml up -d --wait",
    "db:stop": "docker compose -f compose.db.yml stop"
  },
  "dependencies": { "drizzle-orm": "0.45.2", "pg": "8.23.0" },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
