# Prefer scripts/local.ps1 init, which creates a random local-only password.
# This file is for the complete sprue-local Compose project, not cloud deployment.
POSTGRES_PASSWORD=replace-with-64-hex-characters
POSTGRES_PORT=15432
# Set false to bypass cross-account Graph schema caching and Redis connections.
GRAPH_SCHEMA_CACHE_ENABLED=true
REDIS_PORT=16379
API_PORT=3001
FRONTEND_PORT=4173
AGENT_TIMEOUT_MS=600000
AGENT_RUN_TIMEOUT_MS=3600000
# Enables additional server-side planning metadata diagnostics. Keep false outside local debugging.
AGENT_DEBUG=false
# Optional API-only semantic retrieval over inspected Subgraph entities. No vectors are cached.
EMBEDDING_ENABLED=false
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_MS=600000
# Set both values to enable Google and GitHub creator login.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Required by the API for durable encrypted Model Service and Graph credentials.
# Use a 32-byte base64url key; do not copy this file's placeholder.
MODEL_CREDENTIAL_KEYRING={"local-v1":"replace-with-43-character-base64url-key"}
MODEL_CREDENTIAL_ACTIVE_KEY_ID=local-v1
# Source discovery and Graph data access use The Graph mainnet environment.
GRAPH_GATEWAY_ENVIRONMENT=mainnet
# Initial Hedera settlement profile. Mainnet is intentionally rejected by the backend.
HEDERA_NETWORK=hedera:testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_PORTAL_PAT=
HEDERA_FAUCET_URL=https://portal.hedera.com/api/disbursement/cli
HEDERA_FAUCET_AMOUNT_HBAR=1
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
